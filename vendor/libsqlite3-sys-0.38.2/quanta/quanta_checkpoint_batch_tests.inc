/* Independent scalar-image and fake-file oracle for checkpoint DB packets.
 * Included only after the private qiv_checkpoint_batch helper. */
#define QIV_CKPT_TEST_BYTES (9 * QIV_CKPT_MAX_PAGE + 64)
#define QIV_CKPT_TEST_CALLS 8

typedef struct qiv_ckpt_test_file {
  sqlite3_file base;
  u8 image[QIV_CKPT_TEST_BYTES];
  i64 offsets[QIV_CKPT_TEST_CALLS];
  int lengths[QIV_CKPT_TEST_CALLS];
  int writes;
  int fail_at;
  int partial_at;
} qiv_ckpt_test_file;

static int qiv_ckpt_test_write(
    sqlite3_file *base, const void *data, int amount, i64 offset) {
  qiv_ckpt_test_file *file = (qiv_ckpt_test_file *)base;
  int slot = file->writes;
  if (slot >= QIV_CKPT_TEST_CALLS || amount <= 0 || offset < 0 ||
      amount > QIV_CKPT_TEST_BYTES ||
      offset > (i64)QIV_CKPT_TEST_BYTES - amount)
    return SQLITE_IOERR_WRITE;
  file->offsets[slot] = offset;
  file->lengths[slot] = amount;
  file->writes++;
  if (file->writes == file->fail_at) return SQLITE_FULL;
  if (file->writes == file->partial_at) {
    memcpy(file->image + offset, data, amount < 17 ? amount : 17);
    return SQLITE_IOERR_WRITE;
  }
  memcpy(file->image + offset, data, amount);
  return SQLITE_OK;
}

static const sqlite3_io_methods qiv_ckpt_test_methods = {
  .iVersion = 1,
  .xWrite = qiv_ckpt_test_write
};

static void qiv_ckpt_test_init(qiv_ckpt_test_file *file) {
  memset(file, 0, sizeof(*file));
  memset(file->image, 0xa5, sizeof(file->image));
  file->base.pMethods = &qiv_ckpt_test_methods;
}

static u8 qiv_ckpt_test_pattern(int page, int byte) {
  return (u8)(page * 37 + byte * 13 + 7);
}

static void qiv_ckpt_test_page(u8 *page, int ordinal, int size) {
  int byte;
  for (byte = 0; byte < size; byte++)
    page[byte] = qiv_ckpt_test_pattern(ordinal, byte);
}

static int qiv_ckpt_test_call(
    const qiv_ckpt_test_file *file, int slot, i64 offset, int amount) {
  return slot < file->writes && file->offsets[slot] == offset &&
      file->lengths[slot] == amount;
}

/* The expected image is generated by scalar page writes, not by the packet
 * helper or its buffer. The initialized sentinel covers every unwritten byte. */
static int qiv_ckpt_test_success(int size, int count, int gap) {
  qiv_ckpt_test_file file;
  qiv_checkpoint_batch state;
  u8 page[QIV_CKPT_MAX_PAGE];
  u8 expected[QIV_CKPT_TEST_BYTES];
  int ordinal, byte, calls;
  qiv_ckpt_test_init(&file);
  qiv_checkpoint_batch_init(&state);
  memset(expected, 0xa5, sizeof(expected));
  if (qiv_checkpoint_batch_flush(&state, &file.base) != SQLITE_OK ||
      file.writes != 0)
    return SQLITE_ERROR;
  for (ordinal = 0; ordinal < count; ordinal++) {
    i64 offset = (i64)(ordinal + (gap && ordinal >= 2)) * size;
    qiv_ckpt_test_page(page, ordinal, size);
    for (byte = 0; byte < size; byte++)
      expected[offset + byte] = qiv_ckpt_test_pattern(ordinal, byte);
    if (qiv_checkpoint_batch_append(
            &state, &file.base, page, size, offset) != SQLITE_OK)
      return SQLITE_ERROR;
    if (!gap && ordinal == 7 &&
        (file.writes != 1 || state.nPage != 0))
      return SQLITE_ERROR;
  }
  if (qiv_checkpoint_batch_flush(&state, &file.base) != SQLITE_OK ||
      state.nPage != 0 || memcmp(file.image, expected, sizeof(expected)) != 0)
    return SQLITE_ERROR;
  calls = file.writes;
  if (qiv_checkpoint_batch_flush(&state, &file.base) != SQLITE_OK ||
      file.writes != calls)
    return SQLITE_ERROR;
  if (gap) {
    if (count != 3 || calls != 2 ||
        !qiv_ckpt_test_call(&file, 0, 0, 2 * size) ||
        !qiv_ckpt_test_call(&file, 1, 3 * (i64)size, size))
      return SQLITE_ERROR;
  } else if (count == 9) {
    if (calls != 2 ||
        !qiv_ckpt_test_call(&file, 0, 0, 8 * size) ||
        !qiv_ckpt_test_call(&file, 1, 8 * (i64)size, size))
      return SQLITE_ERROR;
  } else if (calls != 1 || !qiv_ckpt_test_call(&file, 0, 0, count * size)) {
    return SQLITE_ERROR;
  }
  return SQLITE_OK;
}

static int qiv_ckpt_test_first_failure(void) {
  qiv_ckpt_test_file file;
  qiv_checkpoint_batch state;
  u8 page[QIV_CKPT_MAX_PAGE];
  int ordinal, byte;
  qiv_ckpt_test_init(&file);
  qiv_checkpoint_batch_init(&state);
  file.fail_at = 1;
  for (ordinal = 0; ordinal < 8; ordinal++) {
    int rc;
    qiv_ckpt_test_page(page, ordinal, QIV_CKPT_MAX_PAGE);
    rc = qiv_checkpoint_batch_append(
        &state, &file.base, page, QIV_CKPT_MAX_PAGE,
        (i64)ordinal * QIV_CKPT_MAX_PAGE);
    if (rc != (ordinal == 7 ? SQLITE_FULL : SQLITE_OK)) return SQLITE_ERROR;
  }
  if (state.nPage != 8 || state.szPage != QIV_CKPT_MAX_PAGE ||
      state.offset != 0 || file.writes != 1 ||
      !qiv_ckpt_test_call(&file, 0, 0, 8 * QIV_CKPT_MAX_PAGE))
    return SQLITE_ERROR;
  for (byte = 0; byte < QIV_CKPT_TEST_BYTES; byte++) {
    if (file.image[byte] != 0xa5) return SQLITE_ERROR;
  }
  return SQLITE_OK;
}

static int qiv_ckpt_test_later_failure(void) {
  qiv_ckpt_test_file file;
  qiv_checkpoint_batch state;
  u8 page[QIV_CKPT_MAX_PAGE];
  int ordinal, byte;
  qiv_ckpt_test_init(&file);
  qiv_checkpoint_batch_init(&state);
  file.fail_at = 2;
  for (ordinal = 0; ordinal < 9; ordinal++) {
    qiv_ckpt_test_page(page, ordinal, QIV_CKPT_MAX_PAGE);
    if (qiv_checkpoint_batch_append(
            &state, &file.base, page, QIV_CKPT_MAX_PAGE,
            (i64)ordinal * QIV_CKPT_MAX_PAGE) != SQLITE_OK)
      return SQLITE_ERROR;
  }
  if (qiv_checkpoint_batch_flush(&state, &file.base) != SQLITE_FULL ||
      state.nPage != 1 || state.szPage != QIV_CKPT_MAX_PAGE ||
      state.offset != 8 * (i64)QIV_CKPT_MAX_PAGE || file.writes != 2 ||
      !qiv_ckpt_test_call(&file, 0, 0, 8 * QIV_CKPT_MAX_PAGE) ||
      !qiv_ckpt_test_call(&file, 1, 8 * (i64)QIV_CKPT_MAX_PAGE,
                          QIV_CKPT_MAX_PAGE))
    return SQLITE_ERROR;
  for (byte = 0; byte < QIV_CKPT_TEST_BYTES; byte++) {
    u8 expected = byte < 8 * QIV_CKPT_MAX_PAGE
        ? qiv_ckpt_test_pattern(byte / QIV_CKPT_MAX_PAGE,
                                byte % QIV_CKPT_MAX_PAGE)
        : 0xa5;
    if (file.image[byte] != expected) return SQLITE_ERROR;
  }
  return SQLITE_OK;
}

static int qiv_ckpt_test_partial_failure(void) {
  qiv_ckpt_test_file file;
  qiv_checkpoint_batch state;
  u8 page[QIV_CKPT_MAX_PAGE];
  int ordinal, byte;
  qiv_ckpt_test_init(&file);
  qiv_checkpoint_batch_init(&state);
  file.partial_at = 1;
  for (ordinal = 0; ordinal < 2; ordinal++) {
    qiv_ckpt_test_page(page, ordinal, QIV_CKPT_MAX_PAGE);
    if (qiv_checkpoint_batch_append(
            &state, &file.base, page, QIV_CKPT_MAX_PAGE,
            (i64)ordinal * QIV_CKPT_MAX_PAGE) != SQLITE_OK)
      return SQLITE_ERROR;
  }
  if (qiv_checkpoint_batch_flush(&state, &file.base) != SQLITE_IOERR_WRITE ||
      state.nPage != 2 || file.writes != 1 ||
      !qiv_ckpt_test_call(&file, 0, 0, 2 * QIV_CKPT_MAX_PAGE))
    return SQLITE_ERROR;
  for (byte = 0; byte < QIV_CKPT_TEST_BYTES; byte++) {
    u8 expected = byte < 17 ? qiv_ckpt_test_pattern(0, byte) : 0xa5;
    if (file.image[byte] != expected) return SQLITE_ERROR;
  }
  return SQLITE_OK;
}

static int qiv_ckpt_test_invalid(void) {
  qiv_ckpt_test_file file;
  qiv_checkpoint_batch state;
  u8 page[QIV_CKPT_MAX_PAGE];
  static const int invalid_sizes[] = {0, -1, QIV_CKPT_MAX_PAGE + 1, 0x7fffffff};
  static const i64 invalid_offsets[] = {
    -QIV_CKPT_MAX_PAGE, 1,
    (LARGEST_INT64 / QIV_CKPT_MAX_PAGE) * QIV_CKPT_MAX_PAGE
  };
  unsigned slot;
  qiv_ckpt_test_init(&file);
  qiv_checkpoint_batch_init(&state);
  qiv_ckpt_test_page(page, 0, QIV_CKPT_MAX_PAGE);
  if (qiv_can_batch_checkpoint_pages(&file.base, &file.base) ||
      qiv_can_batch_checkpoint_pages(0, &file.base) ||
      qiv_can_batch_checkpoint_pages(&file.base, 0))
    return SQLITE_ERROR;
  for (slot = 0; slot < sizeof(invalid_sizes)/sizeof(invalid_sizes[0]); slot++) {
    if (qiv_checkpoint_batch_append(
            &state, &file.base, page, invalid_sizes[slot], 0) == SQLITE_OK ||
        state.nPage != 0 || file.writes != 0)
      return SQLITE_ERROR;
  }
  for (slot = 0; slot < sizeof(invalid_offsets)/sizeof(invalid_offsets[0]); slot++) {
    if (qiv_checkpoint_batch_append(
            &state, &file.base, page, QIV_CKPT_MAX_PAGE,
            invalid_offsets[slot]) == SQLITE_OK ||
        state.nPage != 0 || file.writes != 0)
      return SQLITE_ERROR;
  }
  if (qiv_checkpoint_batch_append(
          &state, &file.base, page, 1024, 0) != SQLITE_OK ||
      state.nPage != 1 || file.writes != 0)
    return SQLITE_ERROR;
  if (qiv_checkpoint_batch_append(
          &state, &file.base, page, QIV_CKPT_MAX_PAGE,
          QIV_CKPT_MAX_PAGE) == SQLITE_OK ||
      state.nPage != 1 || state.szPage != 1024 || file.writes != 0)
    return SQLITE_ERROR;
  if (qiv_checkpoint_batch_flush(&state, &file.base) != SQLITE_OK ||
      file.writes != 1 || !qiv_ckpt_test_call(&file, 0, 0, 1024))
    return SQLITE_ERROR;
  return SQLITE_OK;
}

int qiv_test_checkpoint_batch_protocol(void) {
  if (qiv_ckpt_test_success(1024, 2, 0) != SQLITE_OK ||
      qiv_ckpt_test_success(1024, 8, 0) != SQLITE_OK ||
      qiv_ckpt_test_success(1024, 9, 0) != SQLITE_OK ||
      qiv_ckpt_test_success(1024, 3, 1) != SQLITE_OK ||
      qiv_ckpt_test_success(4096, 2, 0) != SQLITE_OK ||
      qiv_ckpt_test_success(4096, 8, 0) != SQLITE_OK ||
      qiv_ckpt_test_success(4096, 9, 0) != SQLITE_OK ||
      qiv_ckpt_test_success(4096, 3, 1) != SQLITE_OK ||
      qiv_ckpt_test_first_failure() != SQLITE_OK ||
      qiv_ckpt_test_later_failure() != SQLITE_OK ||
      qiv_ckpt_test_partial_failure() != SQLITE_OK ||
      qiv_ckpt_test_invalid() != SQLITE_OK)
    return SQLITE_ERROR;
  return SQLITE_OK;
}
