#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

has_arg() {
  local needle="$1"
  shift

  local arg
  for arg in "$@"; do
    if [[ "$arg" == "$needle" ]]; then
      return 0
    fi
  done

  return 1
}

arg_value() {
  local short_flag="$1"
  local long_flag="$2"
  shift 2

  local expect_value="0"
  local arg
  for arg in "$@"; do
    if [[ "$expect_value" == "1" ]]; then
      printf '%s\n' "$arg"
      return 0
    fi

    case "$arg" in
      "${short_flag}"|"${long_flag}")
        expect_value="1"
        ;;
      "${short_flag}="*|"${long_flag}="*)
        printf '%s\n' "${arg#*=}"
        return 0
        ;;
    esac
  done

  return 1
}

detect_lane() {
  local subcommand="${1:-}"
  if [[ "$#" -gt 0 ]]; then
    shift
  fi

  local package_name=""
  if package_name="$(arg_value "-p" "--package" "$@")"; then
    :
  else
    package_name=""
  fi

  case "$subcommand" in
    check|build)
      if has_arg "--release" "$@"; then
        if [[ "$package_name" == "quanta-index-searchd-runtime" ]]; then
          printf '%s\n' "release-daemon-bin-lane"
          return 0
        fi
        if [[ "$package_name" == "quanta-index-searchctl" || "$package_name" == "quanta-index-corpus-smoke" ]]; then
          printf '%s\n' "release-bin-lane"
          return 0
        fi
        if has_arg "--all-targets" "$@"; then
          printf '%s\n' "release-all-targets-lane"
          return 0
        fi
        if has_arg "--lib" "$@" && has_arg "--bins" "$@"; then
          printf '%s\n' "release-fast-lane"
          return 0
        fi
        printf '%s\n' "release-lane"
        return 0
      fi

      if has_arg "--timings" "$@"; then
        if [[ "$package_name" == "quanta-index-searchd-runtime" ]]; then
          printf '%s\n' "timings-daemon-lane"
          return 0
        fi
        if has_arg "--all-targets" "$@"; then
          printf '%s\n' "timings-all-targets-lane"
          return 0
        fi
        printf '%s\n' "timings-fast-lane"
        return 0
      fi

      if [[ "$package_name" == "quanta-index-searchd-runtime" ]]; then
        printf '%s\n' "daemon-lane"
        return 0
      fi
      if has_arg "--all-targets" "$@"; then
        printf '%s\n' "all-targets-lane"
        return 0
      fi
      if has_arg "--lib" "$@" && has_arg "--bins" "$@"; then
        printf '%s\n' "fast-lane"
        return 0
      fi
      printf '%s\n' "dev-lane"
      ;;
    clippy)
      printf '%s\n' "clippy-lane"
      ;;
    test)
      if [[ "$package_name" == "quanta-index-searchd-runtime" ]]; then
        printf '%s\n' "test-daemon-lane"
        return 0
      fi
      if has_arg "--test" "$@"; then
        if [[ "$package_name" == "quanta-index-searchctl" || "$package_name" == "quanta-index-corpus-smoke" ]]; then
          printf '%s\n' "test-cli-smoke-lane"
          return 0
        fi
        printf '%s\n' "test-integration-lane"
        return 0
      fi
      if has_arg "--lib" "$@" && has_arg "--bins" "$@"; then
        printf '%s\n' "test-fast-lane"
        return 0
      fi
      printf '%s\n' "test-workspace-lane"
      ;;
    doc)
      printf '%s\n' "doc-lane"
      ;;
    bench)
      printf '%s\n' "bench-lane"
      ;;
    clean)
      printf '%s\n' "shared"
      ;;
    *)
      printf '%s\n' "shared"
      ;;
  esac
}

log_cargo_event() {
  local lane="$1"
  local lane_source="$2"
  local exit_code="$3"
  local duration_ms="$4"
  local cargo_subcommand="${5:-}"

  if [[ "${QUANTA_INDEX_BUILD_LOGGING:-1}" == "0" ]]; then
    return 0
  fi

  if ! python3 "${SCRIPT_DIR}/../tools/ci/timing/rust_profile_history.py" \
      append-cargo \
      "$lane" \
      "$lane_source" \
      "$exit_code" \
      "$duration_ms" \
      "$cargo_subcommand"; then
    printf 'warning: cargo lane log append failed for lane=%s\n' "$lane" >&2
  fi
}

lane="${QUANTA_INDEX_BUILD_LANE:-}"
lane_source="env"
if [[ "${1:-}" == "--lane" ]]; then
  lane="${2:-}"
  lane_source="explicit"
  shift 2
elif [[ -z "$lane" ]]; then
  lane="$(detect_lane "$@")"
  lane_source="auto"
fi
if [[ "$lane" != "shared" && ! "$lane" =~ ^[a-z0-9][a-z0-9-]*-lane$ ]]; then
  printf 'invalid cargo lane %q; expected shared or a lowercase *-lane name\n' "$lane" >&2
  exit 2
fi
export QUANTA_INDEX_BUILD_LANE="$lane"

# `scripts/quanta-index-env.sh` only fills `CARGO_TARGET_DIR` when it is unset.
# Nested front doors (for example `just rust-profile ...` -> `scripts/cargow`)
# may already carry a shared target dir from an outer scope, which would defeat
# the inner lane selection and collapse distinct release/test caches into the
# same root. Preserve the inherited target dir only when a caller explicitly
# opts out.
if [[ "${QUANTA_INDEX_PRESERVE_CARGO_TARGET_DIR:-0}" != "1" ]]; then
  unset CARGO_TARGET_DIR
fi

# The env script exports cache paths that must affect this process before Cargo.
# shellcheck disable=SC1091
source "${SCRIPT_DIR}/quanta-index-env.sh"

resource_mode="${QUANTA_INDEX_RESOURCE_ADMISSION-auto}"
case "$resource_mode" in
  auto|0|1) ;;
  *) printf 'invalid QUANTA_INDEX_RESOURCE_ADMISSION; expected auto, 0, or 1\n' >&2; exit 2 ;;
esac

needs_resource_admission() {
  case "${1:-}" in
    metadata|fmt|version|--version|-V|--help|-h|help|--list|locate-project|pkgid|read-manifest|tree|search|info) return 1 ;;
    build|check|clippy|test|bench|doc|rustc|rustdoc|llvm-cov|clean) return 0 ;;
    nextest)
      case "${2:-}" in
        run|archive) return 0 ;;
        list)
          # Listing an already prepared binary set cannot invoke Cargo's build
          # graph. Normal lists still compile and must participate in admission.
          # Tokens after -- are test patterns, even when they resemble metadata
          # options. Admit ambiguous tails instead of treating them as reuse.
          if has_arg -- "$@"; then
            return 0
          fi
          local binaries="" metadata=""
          binaries="$(arg_value --binaries-metadata --binaries-metadata "$@")" || true
          metadata="$(arg_value --cargo-metadata --cargo-metadata "$@")" || true
          [[ -z "$binaries" || -z "$metadata" ]]
          return
          ;;
      esac
      ;;
  esac
  # Unknown aliases, subcommands, and leading Cargo global options may build.
  # Conservatively admit them instead of silently bypassing the shared slot.
  return 0
}

run_cargo() {
  if ! needs_resource_admission "$@"; then
    cargo "$@"
  elif [[ "$resource_mode" == "0" || ( "$resource_mode" == "auto" && "${CI:-}" == "true" ) ]]; then
    printf 'cargow: cooperative resource admission disabled (mode=%s, CI=%s)\n' "$resource_mode" "${CI:-unset}" >&2
    cargo "$@"
  else
    # Never wrap a whole Just/benchctl/pytest orchestration in this lease: its
    # nested Cargo calls must acquire independently, without recursive locking.
    python3 "${SCRIPT_DIR}/../tools/ci/resource_admission.py" \
      --lock "${QUANTA_INDEX_CACHE_ROOT}/resource-admission/build-test.lock" \
      --wait-seconds "${QUANTA_INDEX_RESOURCE_WAIT_SECONDS-300}" \
      --timeout-seconds "${QUANTA_INDEX_RESOURCE_TIMEOUT_SECONDS-7200}" \
      -- cargo "$@"
  fi
}

requires_searchd_pin() {
  if [[ -n "${QUANTA_INDEX_SEARCHD_BIN:-}" ]] || ! has_arg "--workspace" "$@"; then
    return 1
  fi

  case "${1:-}" in
    test)
      ! has_arg "--no-run" "$@"
      ;;
    nextest)
      has_arg "run" "$@"
      ;;
    llvm-cov)
      has_arg "nextest" "$@"
      ;;
    *)
      return 1
      ;;
  esac
}

prepare_searchd_pin() {
  run_cargo build -p quanta-index-searchd-runtime --bin quanta-index-searchd --locked
  local binary="${CARGO_TARGET_DIR}/debug/quanta-index-searchd"
  if [[ ! -x "$binary" ]]; then
    printf 'built searchd binary is missing or not executable: %s\n' "$binary" >&2
    return 1
  fi
  export QUANTA_INDEX_SEARCHD_BIN="$binary"
}

if requires_searchd_pin "$@"; then
  prepare_searchd_pin
fi

start_ms="$(python3 -c 'import time; print(time.clock_gettime_ns(time.CLOCK_MONOTONIC) // 1000000)')"

if run_cargo "$@"; then
  status=0
else
  status="$?"
fi

end_ms="$(python3 -c 'import time; print(time.clock_gettime_ns(time.CLOCK_MONOTONIC) // 1000000)')"
duration_ms="$((end_ms - start_ms))"

log_cargo_event "$lane" "$lane_source" "$status" "$duration_ms" "${1:-}"
exit "$status"
