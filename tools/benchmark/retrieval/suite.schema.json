{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanta-index.invalid/benchmark/retrieval/suite-v3",
  "title": "Frozen retrieval suite v3 (W0-A comparison contract)",
  "description": "Only accepted suite artifact shape. Requires a comparison contract (top_k, tokenizer, budget version, output-unit policy) that packs and records must match byte-for-byte; old or unknown stamps are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "repository_commit", "comparison_contract", "routes", "file_universe", "file_universe_digest", "tasks"],
  "properties": {
    "schema_version": {"const": 3},
    "suite_id": {"type": "string", "minLength": 1},
    "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "comparison_contract": {"$ref": "#/$defs/comparison_contract"},
    "routes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "file_universe": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/universe_entry"}
    },
    "file_universe_digest": {
      "type": "string", "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the canonical path-sorted universe entries; the evaluator recomputes it."
    },
    "diagnostic_policy": {
      "const": "observed_prefix_v1",
      "description": "Opt-in per-query observed-prefix diagnostics. Omission preserves historical report bytes during replay."
    },
    "leakage_allowlist": {
      "type": "array",
      "items": {"$ref": "#/$defs/allowlisted_span"},
      "description": "Spans explicitly permitted to overlap across splits, each with a reviewer rationale digest."
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "allOf": [
    {
      "if": {"required": ["diagnostic_policy"]},
      "then": {"properties": {"comparison_contract": {"properties": {"top_k": {"minimum": 10}}}}}
    },
    {
      "if": {"properties": {"tasks": {"contains": {"anyOf": [
        {"required": ["query_intent"]}, {"required": ["label_review"]},
        {"required": ["file_judgments"]}, {"required": ["declaration_judgments"]},
        {"required": ["judgment_policy"]}, {"required": ["source_oracle"]}
      ]}}}},
      "then": {"required": ["diagnostic_policy"]}
    }
  ],
  "$defs": {
    "comparison_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["top_k", "tokenizer", "tokenizer_budget_version", "output_unit_policy", "span_unit"],
      "properties": {
        "top_k": {"type": "integer", "minimum": 1},
        "tokenizer": {"const": "qi-regex-v1"},
        "tokenizer_budget_version": {"const": "qb-v1"},
        "output_unit_policy": {
          "enum": ["rank_prefix"],
          "description": "Only rank-prefix budget truncation is implemented. Any other policy needs a contract amendment, not a new string."
        },
        "span_unit": {
          "const": "byte_span_with_line_projection_v1",
          "description": "Coverage is decided by byte-span containment; line spans are a consistency-checked projection only."
        }
      }
    },
    "allowlisted_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "rationale_digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "rationale_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "universe_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "file_judgment": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "grade"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grade": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "declaration_judgment": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "start_byte", "end_byte", "grade"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "grade": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_byte", "end_byte", "start_line", "end_line", "file_sha256", "block_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "block_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grade": {"type": "integer", "minimum": 1, "maximum": 3, "description": "A gold span must be relevant; grade 0 judgments are excluded from gold."}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "split", "query", "query_sha256", "query_family_id", "answerable", "gold"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "eval"]},
        "query": {"type": "string", "minLength": 1},
        "query_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "query_family_id": {
          "type": "string", "minLength": 1,
          "description": "Paraphrase family. One family must not appear in both train and eval."
        },
        "answerable": {"type": "boolean"},
        "category": {"type": "string", "minLength": 1},
        "query_intent": {
          "enum": ["bare_symbol", "semantic_intent"],
          "description": "Suite-author declaration. This is omitted from the blinded runner pack."
        },
        "label_review": {"$ref": "#/$defs/label_review"},
        "judgment_policy": {"enum": ["unjudged_zero_v1", "complete_ranked_pool_v1", "source_oracle_complete_v1"]},
        "source_oracle": {"$ref": "#/$defs/source_oracle"},
        "file_judgments": {"type": "array", "items": {"$ref": "#/$defs/file_judgment"}},
        "declaration_judgments": {"type": "array", "items": {"$ref": "#/$defs/declaration_judgment"}},
        "gold": {"type": "array", "items": {"$ref": "#/$defs/block"}}
      },
      "allOf": [
        {"if": {"properties": {"answerable": {"const": true}}}, "then": {"properties": {"gold": {"minItems": 1}}}},
        {"if": {"properties": {"answerable": {"const": false}}}, "then": {"properties": {"gold": {"maxItems": 0}}}},
        {"if": {"anyOf": [{"required": ["file_judgments"]}, {"required": ["declaration_judgments"]}]},
         "then": {"required": ["judgment_policy"], "anyOf": [{"required": ["label_review"]}, {"required": ["source_oracle"]}]}},
        {"if": {"required": ["source_oracle"]},
         "then": {
           "required": ["query_intent", "judgment_policy"],
           "properties": {
             "query_intent": {"const": "bare_symbol"},
             "judgment_policy": {"const": "source_oracle_complete_v1"}
           },
           "not": {"required": ["label_review"]},
           "allOf": [
             {"if": {"properties": {"source_oracle": {"properties": {"unit": {"const": "symbol"}}}}},
              "then": {"required": ["declaration_judgments"], "not": {"required": ["file_judgments"]}}},
             {"if": {"properties": {"source_oracle": {"properties": {"unit": {"const": "distinct_file"}}}}},
              "then": {"required": ["file_judgments"], "not": {"required": ["declaration_judgments"]}}}
           ]
         }},
        {"if": {"required": ["judgment_policy"], "properties": {"judgment_policy": {"const": "source_oracle_complete_v1"}}},
         "then": {"required": ["source_oracle"]}}
      ]
    },
    "source_oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "unit"],
      "properties": {
        "contract": {"enum": [
          "go_exact_local_name_v3", "ascii_identifier_word_v1",
          "ascii_content_absent_casefold_v1", "ascii_code_search_absent_casefold_v1",
          "ascii_identifier_osa1_absent_casefold_v1",
          "go_declaration_name_prefix_v1", "go_declaration_name_infix_v1",
          "go_declaration_name_components_v1", "go_declaration_name_osa1_v1", "go_declaration_name_osa1_casefold_v1",
          "rust_exact_local_name_v1", "rust_declaration_name_prefix_v1", "rust_declaration_name_infix_v1", "rust_declaration_name_components_v1", "rust_declaration_name_osa1_v1", "rust_declaration_name_osa1_casefold_v1",
          "python_exact_local_name_v1", "python_declaration_name_prefix_v1", "python_declaration_name_infix_v1", "python_declaration_name_components_v1", "python_declaration_name_osa1_v1", "python_declaration_name_osa1_casefold_v1",
          "typescript_exact_local_name_v1", "typescript_declaration_name_prefix_v1", "typescript_declaration_name_infix_v1", "typescript_declaration_name_components_v1", "typescript_declaration_name_osa1_v1", "typescript_declaration_name_osa1_casefold_v1",
          "javascript_exact_local_name_v1", "javascript_declaration_name_prefix_v1", "javascript_declaration_name_infix_v1", "javascript_declaration_name_components_v1", "javascript_declaration_name_osa1_v1", "javascript_declaration_name_osa1_casefold_v1"
        ]},
        "unit": {"enum": ["symbol", "distinct_file"]},
        "declaration_exclusions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "description": "Per-task parser-refused paths proven unable to contain the queried declaration name; files remain in the universe."
        }
      },
      "allOf": [
        {"if": {"properties": {"contract": {"const": "ascii_identifier_word_v1"}}},
         "then": {"properties": {"unit": {"const": "distinct_file"}}}},
        {"if": {"properties": {"contract": {"const": "ascii_content_absent_casefold_v1"}}},
         "then": {"properties": {"unit": {"const": "distinct_file"}}}},
        {"if": {"properties": {"contract": {"const": "ascii_code_search_absent_casefold_v1"}}},
         "then": {"properties": {"unit": {"const": "distinct_file"}}}},
        {"if": {"properties": {"contract": {"const": "ascii_identifier_osa1_absent_casefold_v1"}}},
         "then": {"properties": {"unit": {"const": "distinct_file"}}}},
        {"if": {"required": ["declaration_exclusions"]},
         "then": {"properties": {"contract": {"enum": [
           "go_exact_local_name_v3", "go_declaration_name_prefix_v1", "go_declaration_name_infix_v1", "go_declaration_name_components_v1", "go_declaration_name_osa1_v1", "go_declaration_name_osa1_casefold_v1",
           "rust_exact_local_name_v1", "rust_declaration_name_prefix_v1", "rust_declaration_name_infix_v1", "rust_declaration_name_components_v1", "rust_declaration_name_osa1_v1", "rust_declaration_name_osa1_casefold_v1",
           "python_exact_local_name_v1", "python_declaration_name_prefix_v1", "python_declaration_name_infix_v1", "python_declaration_name_components_v1", "python_declaration_name_osa1_v1", "python_declaration_name_osa1_casefold_v1",
           "typescript_exact_local_name_v1", "typescript_declaration_name_prefix_v1", "typescript_declaration_name_infix_v1", "typescript_declaration_name_components_v1", "typescript_declaration_name_osa1_v1", "typescript_declaration_name_osa1_casefold_v1",
           "javascript_exact_local_name_v1", "javascript_declaration_name_prefix_v1", "javascript_declaration_name_infix_v1", "javascript_declaration_name_components_v1", "javascript_declaration_name_osa1_v1", "javascript_declaration_name_osa1_casefold_v1"
         ]}}}}
      ],
      "description": "Exhaustive source-derived labels rechecked against the frozen file universe; this is not a human review claim."
    },
    "label_review": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment"],
      "properties": {
        "assessment": {"enum": ["unreviewed", "reviewed_unambiguous", "reviewed_ambiguous"]},
        "reviewer_id": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"assessment": {"const": "unreviewed"}}},
          "then": {"not": {"anyOf": [{"required": ["reviewer_id"]}, {"required": ["evidence_sha256"]}]}}
        },
        {
          "if": {"properties": {"assessment": {"enum": ["reviewed_unambiguous", "reviewed_ambiguous"]}}},
          "then": {"required": ["reviewer_id", "evidence_sha256"]}
        }
      ],
      "description": "Authored review claim, bound to external review evidence; evaluator does not verify reviewer independence."
    }
  }
}
