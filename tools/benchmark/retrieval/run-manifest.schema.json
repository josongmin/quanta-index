{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanta-index.invalid/benchmark/retrieval/run-manifest-v2",
  "title": "Retrieval run manifest v2",
  "description": "Driver-observed manifest. Booleans/counts here are NEVER verdict authority: every digest claim is re-derived by the verdict from the sibling artifact bytes (paths resolve relative to this manifest file; absolute paths and '..' escape are refused). Contract/SDK evidence binds verification receipts to their underlying test-result artifacts by digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "blinding", "isolation_method", "access_block_log", "scope", "claims", "repetitions", "evidence", "host", "artifacts", "provenance"],
  "properties": {
    "manifest_version": {"const": 2},
    "blinding": {"enum": ["isolated", "attested"]},
    "isolation_method": {"type": "string", "minLength": 1},
    "access_block_log": {"type": "string", "minLength": 1},
    "scope": {"enum": ["exploratory", "qualified"]},
    "claims": {
      "type": "object", "additionalProperties": false,
      "required": ["quality", "speed", "same_model", "incremental"],
      "properties": {
        "quality": {"type": "boolean"},
        "speed": {"type": "boolean"},
        "same_model": {"type": "boolean"},
        "incremental": {"type": "boolean"}
      }
    },
    "repetitions": {"type": "integer", "minimum": 1},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["pair", "perf"],
      "properties": {
        "contract_suites": {
          "type": "object", "additionalProperties": false,
          "required": ["python", "rust"],
          "properties": {
            "python": {"$ref": "#/$defs/contract_digest_claim"},
            "rust": {"$ref": "#/$defs/contract_digest_claim"}
          }
        },
        "sdk_path": {
          "type": "object", "additionalProperties": false,
          "required": ["test_result_digest", "nextest_digest", "runner_record_digest", "inventory_digest", "separate_process", "sealed_receipt", "activation_ack", "empty_check"],
          "properties": {
            "test_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "nextest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "runner_record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "separate_process": {"type": "boolean"},
            "sealed_receipt": {"type": "boolean"},
            "activation_ack": {"type": "boolean"},
            "empty_check": {"type": "boolean"}
          }
        },
        "pair": {
          "type": "object", "additionalProperties": false,
          "required": ["mapping_proof_digest"],
          "properties": {
            "mapping_proof_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "perf": {
          "type": "object", "additionalProperties": false,
          "required": ["observations_floor", "fresh_roots", "phase_boundaries", "resource_accounting"],
          "properties": {
            "observations_floor": {"type": "integer", "minimum": 0},
            "fresh_roots": {"type": "integer", "minimum": 0},
            "phase_boundaries": {"type": "boolean"},
            "resource_accounting": {"type": "boolean"}
          }
        },
        "model_parity": {"$ref": "#/$defs/digest_claim"},
        "incremental": {"$ref": "#/$defs/digest_claim"}
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["start_digest", "end_digest", "cache_regime"],
      "properties": {
        "start_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "end_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cache_regime": {"enum": ["true_process_cold", "warm_cache", "undeclared"]},
        "delegated_cgroup_parent": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "device", "inode"],
          "properties": {
            "path": {"type": "string", "pattern": "^/[^\\n]+$"},
            "device": {"type": "integer", "minimum": 1},
            "inode": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["suite", "query_pack", "corpus_manifest", "mapping_proof", "latency_matrix", "host_start", "host_end", "host_profile", "records", "reports", "quanta_manifests", "semble_adapter_manifest", "semble_lockfile", "semble_native", "semble_model_cache_manifests", "phase_metrics", "phase_metrics_digests", "symbol_preflights", "resource_metrics", "protocol_lock", "driver_source_closure"],
      "properties": {
        "suite": {"type": "string", "minLength": 1},
        "query_pack": {"type": "string", "minLength": 1},
        "corpus_manifest": {"type": "string", "minLength": 1},
        "mapping_proof": {"type": "string", "minLength": 1},
        "latency_matrix": {"type": "string", "minLength": 1},
        "host_start": {"type": "string", "minLength": 1},
        "host_end": {"type": "string", "minLength": 1},
        "host_profile": {"type": "string", "minLength": 1},
        "admission_manifest": {"type": "string", "minLength": 1},
        "experiment_custody": {"type": "string", "minLength": 1},
        "development_suite": {"type": "string", "minLength": 1},
        "split_manifest": {"type": "string", "minLength": 1},
        "split_releases": {"type": "string", "minLength": 1},
        "license_receipt": {"type": "string", "minLength": 1},
        "annotation_receipts": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "adjudication_receipt": {"type": "string", "minLength": 1},
        "records": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
          "description": "Every rep's per-system records (rep-0 for scoring, all reps for the latency matrix)."
        },
        "reports": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "quanta_manifests": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "semble_adapter_manifest": {
          "type": "string", "minLength": 1,
          "description": "Rep-0 adapter manifest: Semble version, interpreter identity, model asset digest."
        },
        "semble_lockfile": {
          "type": "string", "minLength": 1,
          "description": "Rep-0 external exact-environment freeze copy whose whole-file digest must equal the pinned digest."
        },
        "semble_native": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
          "description": "Every rep's native.json: the verdict re-derives the full latency matrix from records + natives."
        },
        "semble_model_cache_manifests": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
          "description": "One symlink-free pinned model cache manifest per Semble capture root."
        },
        "symbol_preflights": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "phase_metrics_digests": {
          "type": "object",
          "description": "Exact manifest-relative phase path to SHA256 of captured file bytes; keys must match phase_metrics.",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "phase_metrics": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
          "description": "One monotonic phase-boundary artifact per raw capture."
        },
        "resource_metrics": {
          "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
          "description": "One owned process-tree peak-RSS artifact per raw capture."
        },
        "protocol_lock": {
          "type": "string", "minLength": 1,
          "description": "Frozen input digests + pins. The verdict re-verifies its digests against the frozen bytes."
        },
        "driver_source_closure": {
          "type": "string", "minLength": 1,
          "description": "Start/end verified retrieval source closure for every pair capture."
        },
        "isolation_proof": {
          "type": "string", "minLength": 1,
          "description": "Required by the verdict for isolated QUALITY_DELTA: current tagged backend policy identity, denied roots, file bindings and actual runner-child deny/allow probes. Linux threat_model=filesystem-path-read-v1 assumes trusted stdio and mount topology; IPC and metadata are outside this proof."
        },
        "contract_execution_context": {"type": "string", "minLength": 1},
        "contract_execution_logs": {"type": "string", "minLength": 1},
        "contract_source_closure": {"type": "string", "minLength": 1},
        "contract_python_receipt": {"type": "string", "minLength": 1},
        "contract_python_results": {"type": "string", "minLength": 1},
        "contract_python_raw": {"type": "string", "minLength": 1},
        "contract_python_inventory": {"type": "string", "minLength": 1},
        "contract_rust_receipt": {"type": "string", "minLength": 1},
        "contract_rust_results": {"type": "string", "minLength": 1},
        "contract_rust_raw": {"type": "string", "minLength": 1},
        "contract_rust_inventory": {"type": "string", "minLength": 1},
        "sdk_execution_context": {"type": "string", "minLength": 1},
        "sdk_execution_logs": {"type": "string", "minLength": 1},
        "sdk_source_closure": {"type": "string", "minLength": 1},
        "sdk_receipt": {"type": "string", "minLength": 1},
        "sdk_results": {"type": "string", "minLength": 1},
        "sdk_nextest_raw": {"type": "string", "minLength": 1},
        "sdk_record_raw": {"type": "string", "minLength": 1},
        "sdk_inventory": {"type": "string", "minLength": 1},
        "model_parity_results": {"type": "string", "minLength": 1},
        "incremental_results": {"type": "string", "minLength": 1}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["admission", "quanta", "semble", "corpus", "suite", "host"],
      "properties": {
        "admission": {
          "type": "object", "additionalProperties": false,
          "required": ["manifest_digest"],
          "properties": {
            "manifest_digest": {
              "anyOf": [
                {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                {"type": "null"}
              ]
            }
          }
        },
        "quanta": {
          "type": "object", "additionalProperties": false,
          "required": ["source_sha", "source_closure_digest", "binary_digest", "embedder"],
          "properties": {
            "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "source_closure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "binary_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "embedder": {"enum": ["potion-code", "potion-code-full-v2", "hash-dev"]}
          }
        },
        "semble": {
          "type": "object", "additionalProperties": false,
          "required": ["revision", "lockfile_digest", "interpreter_digest", "model_asset_digest"],
          "properties": {
            "revision": {"const": "0.6.0"},
            "lockfile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "interpreter_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "model_asset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "corpus": {
          "type": "object", "additionalProperties": false,
          "required": ["digest", "path_sha_diff_digest"],
          "properties": {
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "path_sha_diff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "suite": {
          "type": "object", "additionalProperties": false,
          "required": ["suite_digest", "query_pack_digest", "tokenizer_budget_version"],
          "properties": {
            "suite_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "query_pack_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "tokenizer_budget_version": {"const": "qb-v1"}
          }
        },
        "host": {
          "type": "object", "additionalProperties": false,
          "required": ["profile_digest", "check_record_digest"],
          "properties": {
            "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "check_record_digest": {
              "type": "string", "pattern": "^[0-9a-f]{64}$",
              "description": "sha256 of canonical({\"start\": host_start_bytes, \"end\": host_end_bytes}) re-derived from the host artifacts."
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"blinding": {"const": "isolated"}}, "required": ["blinding"]},
      "then": {
        "properties": {
          "isolation_method": {"enum": ["macos-seatbelt-v1", "linux-landlock-fs-prototype-v1"]},
          "access_block_log": {"pattern": "^sha256:[0-9a-f]{64}$"},
          "artifacts": {"required": ["isolation_proof"]}
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "qualified"}}},
      "then": {
        "properties": {
          "artifacts": {
            "required": ["admission_manifest", "license_receipt", "annotation_receipts", "adjudication_receipt"],
            "oneOf": [
              {"required": ["experiment_custody", "development_suite"], "not": {"anyOf": [{"required": ["split_manifest"]}, {"required": ["split_releases"]}]}},
              {"required": ["split_manifest", "split_releases"], "not": {"anyOf": [{"required": ["experiment_custody"]}, {"required": ["development_suite"]}]}}
            ]
          },
          "provenance": {
            "properties": {
              "admission": {
                "properties": {
                  "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "properties": {
              "admission": {
                "properties": {"manifest_digest": {"type": "null"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["provenance"],
        "properties": {"provenance": {
          "required": ["quanta"],
          "properties": {"quanta": {
            "required": ["embedder"],
            "properties": {"embedder": {"const": "potion-code-full-v2"}}
          }}
        }}
      },
      "then": {
        "properties": {
          "scope": {"const": "exploratory"},
          "claims": {"properties": {
            "quality": {"const": false}, "speed": {"const": false},
            "same_model": {"const": false}, "incremental": {"const": false}
          }}
        }
      }
    }
  ],
  "$defs": {
    "contract_digest_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["test_result_digest", "raw_evidence_digest", "inventory_digest"],
      "properties": {
        "test_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inventory_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "digest_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["test_result_digest"],
      "properties": {
        "test_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "verification_receipt": {
      "description": "Must stay identical to tools/ci/verification-receipt.schema.json (a CI test locks the two together). Receipts are sibling artifacts, not embedded here.",
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "revision", "rail", "tier", "command", "evidence_path", "evidence_sha256", "test_event_count"],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "revision": {"type": "string", "minLength": 7},
        "rail": {"type": "string", "minLength": 1},
        "tier": {"enum": ["pr", "merge", "main", "correctness", "nightly", "weekly"]},
        "command": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "inventory_path": {"type": "string", "minLength": 1},
        "inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "test_event_count": {"type": "integer", "minimum": 1},
        "source_closure": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "profile", "revision", "roots", "files", "digest"],
          "properties": {
            "schema_version": {"const": 1},
            "profile": {"const": "retrieval"},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "roots": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "files": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["path", "sha256"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                }
              }
            },
            "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "input_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "sha256"],
            "properties": {
              "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {"schema_version": {"const": 1}},
          "not": {
            "anyOf": [
              {"required": ["source_closure"]},
              {"required": ["input_evidence"]}
            ]
          }
        },
        {
          "required": ["source_closure", "input_evidence"],
          "properties": {
            "schema_version": {"const": 2},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          }
        }
      ]
    }
  }
}
