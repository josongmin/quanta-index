{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchPlaneErrorCodeTableV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enum_type", "enum_source_path", "enum_source_digest", "cardinality", "codes"],
  "properties": {
    "schema_version": {"const": 2},
    "enum_type": {"const": "SearchPlaneErrorCodeV2"},
    "enum_source_path": {"const": "crates/quanta-index-contract/src/ipc/error.rs"},
    "enum_source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cardinality": {"type": "integer", "minimum": 1},
    "codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
    }
  }
}
