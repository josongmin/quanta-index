{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quanta Index ErrorAuthorityInventoryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "source_head",
    "source_digest",
    "categories",
    "p01_completion_requirements",
    "closed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {"const": "crates/*/src/**/*.rs"},
        "exclude": {"type": "array", "maxItems": 0}
      }
    },
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requires_semantic_migration_review", "count", "occurrences"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "requires_semantic_migration_review": {"type": "boolean"},
          "count": {"type": "integer", "minimum": 0},
          "occurrences": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line", "column", "line_sha256"],
              "properties": {
                "path": {"type": "string", "pattern": "^crates/.+/src/.+\\.rs$"},
                "line": {"type": "integer", "minimum": 1},
                "column": {"type": "integer", "minimum": 1},
                "line_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "p01_completion_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_gates"],
      "properties": {
        "manual_gates": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "closed": {"const": false}
  }
}
