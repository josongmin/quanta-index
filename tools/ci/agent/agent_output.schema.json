{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanta-index.local/tools/ci/agent/agent_output.schema.json",
  "title": "Agent Output V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary",
    "source",
    "required_inputs_missing",
    "assumptions",
    "claims",
    "errors",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "status": {
      "type": "string",
      "enum": ["ok", "blocked", "error"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty_digest"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "required_inputs_missing": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "risk", "can_affect_correctness"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "can_affect_correctness": {"type": "boolean"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required",
          "status",
          "detail",
          "command",
          "evidence",
          "covered_scope",
          "excluded_scope"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {
            "type": "string",
            "enum": ["verified", "failed", "blocked", "not_run", "not_applicable"]
          },
          "detail": {"type": "string", "minLength": 1},
          "command": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "kind", "validator"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "kind": {
                  "type": "string",
                  "enum": ["raw_result", "receipt", "report", "log", "other"]
                },
                "validator": {
                  "oneOf": [
                    {"type": "string", "minLength": 1},
                    {"type": "null"}
                  ]
                }
              }
            }
          },
          "covered_scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "excluded_scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "message", "propagated"],
        "properties": {
          "step": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "propagated": {"type": "boolean"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "deployable"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {
            "type": "string",
            "enum": ["rust_source", "manifest", "report", "other"]
          },
          "deployable": {"type": "boolean"}
        }
      }
    }
  }
}
