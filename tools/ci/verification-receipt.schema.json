{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quanta Index verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "revision", "rail", "tier", "command",
    "evidence_path", "evidence_sha256", "test_event_count"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "revision": {"type": "string", "minLength": 7},
    "rail": {"type": "string", "minLength": 1},
    "tier": {"enum": ["pr", "merge", "correctness", "nightly", "weekly"]},
    "command": {"type": "string", "minLength": 1},
    "evidence_path": {"type": "string", "minLength": 1},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "test_event_count": {"type": "integer", "minimum": 1},
    "source_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "revision", "roots", "files", "digest"],
      "properties": {
        "schema_version": {"const": 1},
        "profile": {"const": "retrieval"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "input_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sha256"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {"schema_version": {"const": 1}},
      "not": {
        "anyOf": [
          {"required": ["source_closure"]},
          {"required": ["input_evidence"]}
        ]
      }
    },
    {
      "required": ["source_closure", "input_evidence"],
      "properties": {
        "schema_version": {"const": 2},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    }
  ]
}
