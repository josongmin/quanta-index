{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quanta Index Deployment Selection V2",
  "description": "One canonical V2 wire. Persisted V1 selections are refused and require explicit re-install.",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "binary",
    "binary_sha256",
    "state_root",
    "environment"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "binary": {
      "$ref": "#/$defs/absoluteUnixPath"
    },
    "binary_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_root": {
      "$ref": "#/$defs/absoluteUnixPath"
    },
    "environment": {
      "type": "object",
      "description": "Closed child-process environment. Keys must be in the launcher's allowlist, and values must be NUL-free strings.",
      "maxProperties": 69,
      "additionalProperties": false,
      "properties": {
        "HOME": {
          "$ref": "#/$defs/environmentValue"
        },
        "LANG": {
          "$ref": "#/$defs/environmentValue"
        },
        "LC_ALL": {
          "$ref": "#/$defs/environmentValue"
        },
        "OPENAI_API_KEY": {
          "$ref": "#/$defs/environmentValue"
        },
        "PATH": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_CACHE_ROOT": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_CONTROL_SOCKET_ACCESS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBEDDER": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_BATCH": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_CACHE": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_CACHE_MAX_AGE_SECS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_CACHE_MAX_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_CACHE_MAX_ENTRIES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_CACHE_MAX_NAMESPACES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_CACHE_MAX_TOTAL_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_CONCURRENCY": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_DIM": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_MAX_EST_TOKENS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_MAX_RETRIES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_MODEL": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_MODEL_DIR": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_MODEL_REVISION": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EMBED_TIMEOUT_SECS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_EXPERIMENTAL_HYBRID_FETCH_FLOOR": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_INGEST_MAX_RECORDS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_INGEST_MAX_TEXT_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_INGEST_MAX_VECTOR_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_INGEST_SOCKET_ACCESS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_INTEGRITY_SCRUB_INTERVAL_MS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_INTEGRITY_SCRUB_MAX_BYTES_PER_STEP": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_LEXICAL_MAX_EXAMINED_CANDIDATES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_LEXICAL_WRITER_ENVELOPE_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_LEXICAL_WRITER_HEAP_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_LEXICAL_WRITER_IDLE_SECS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_MAINTENANCE_TICK_MS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROCESS_MEMORY_CEILING_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROCESS_RSS_CEILING_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_COST_CEILING_MICROS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_ENDPOINT": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_MAX_INFLIGHT_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_MAX_INFLIGHT_REQUESTS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_MAX_RETRY_ATTEMPTS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_PROFILE": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_REGION": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_RETENTION": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_SOURCE_CONTENT_CONSENT": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_PROVIDER_TENANT": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_DISPATCH_BUDGET_MS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_DISPATCH_SLOTS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_MAX_CONNECTIONS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_MAX_IN_FLIGHT_PER_REPO": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_QUEUE_WAIT_MS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_RESPONSE_MAX_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_SOCKET_ACCESS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_QUERY_STAGE_OBSERVATION": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_REGEX_CACHE_MAX_ENTRIES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_REGEX_CACHE_MAX_MATCHES_PER_ENTRY": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_REGEX_CACHE_MAX_RESIDENT_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SEARCH_CORPUS_HISTORY_MAX_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SEARCH_CORPUS_HISTORY_MAX_GENERATIONS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SEARCH_CORPUS_HISTORY_MAX_REVISION_PAIRS": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SEARCH_CORPUS_HISTORY_MAX_TOTAL_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SEMANTIC_STREAM_WINDOW_SCOPES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SEMANTIC_STREAM_WINDOW_VECTOR_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SNAPSHOT_MAX_ENTRIES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SNAPSHOT_MAX_RESIDENT_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "QUANTA_INDEX_SOURCE_PUBLICATION_MAX_BYTES": {
          "$ref": "#/$defs/environmentValue"
        },
        "TMPDIR": {
          "$ref": "#/$defs/environmentValue"
        },
        "XDG_CACHE_HOME": {
          "$ref": "#/$defs/environmentValue"
        }
      }
    },
    "mode": {
      "enum": [
        "legacy",
        "native"
      ]
    },
    "native_config": {
      "$ref": "#/$defs/absoluteUnixPath"
    },
    "native_config_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_boot_receipt": {
      "type": "object",
      "description": "Immutable staged cut identity pinned with binary/config; install_catalog_digest_hex is an install-only exact check, never a restart gate.",
      "required": [
        "root_nonce_hex",
        "manifest_operation",
        "manifest_object_hex",
        "source_cut_digest_hex",
        "install_catalog_digest_hex"
      ],
      "additionalProperties": false,
      "properties": {
        "root_nonce_hex": {
          "$ref": "#/$defs/digest64"
        },
        "manifest_operation": {
          "$ref": "#/$defs/nativeOperationKey"
        },
        "manifest_object_hex": {
          "$ref": "#/$defs/digest64"
        },
        "source_cut_digest_hex": {
          "$ref": "#/$defs/digest64"
        },
        "install_catalog_digest_hex": {
          "$ref": "#/$defs/digest64"
        }
      }
    }
  },
  "if": {
    "properties": {
      "mode": {
        "const": "native"
      }
    },
    "required": [
      "mode"
    ]
  },
  "then": {
    "required": [
      "native_config",
      "native_config_sha256",
      "native_boot_receipt"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "native_config"
          ]
        },
        {
          "required": [
            "native_config_sha256"
          ]
        },
        {
          "required": [
            "native_boot_receipt"
          ]
        }
      ]
    }
  },
  "$defs": {
    "absoluteUnixPath": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$",
      "description": "Absolute Unix path without NUL. The launcher separately requires an existing, canonical path and the expected file type."
    },
    "environmentValue": {
      "type": "string",
      "pattern": "^[^\\u0000]*$"
    },
    "digest64": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "id16": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "nativeWorkspaceKey": {
      "type": "object",
      "required": [
        "tenant",
        "collection",
        "worktree",
        "slot"
      ],
      "additionalProperties": false,
      "properties": {
        "tenant": {
          "$ref": "#/$defs/id16"
        },
        "collection": {
          "$ref": "#/$defs/id16"
        },
        "worktree": {
          "$ref": "#/$defs/id16"
        },
        "slot": {
          "$ref": "#/$defs/id16"
        }
      }
    },
    "nativeOperationKey": {
      "type": "object",
      "required": [
        "workspace",
        "epoch",
        "producer",
        "stream",
        "stream_epoch",
        "sequence"
      ],
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "$ref": "#/$defs/nativeWorkspaceKey"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "producer": {
          "$ref": "#/$defs/id16"
        },
        "stream": {
          "$ref": "#/$defs/id16"
        },
        "stream_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    }
  }
}
