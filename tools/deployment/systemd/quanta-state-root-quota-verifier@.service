[Unit]
Description=Quanta StateRoot quota verifier for daemon UID %i
Requires=quanta-state-root-quota-verifier@%i.socket
After=quanta-state-root-quota-verifier@%i.socket

[Service]
ExecStart=/usr/local/libexec/quanta-state-root-quota-verifier --client-uid %i
User=root
Group=root
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
