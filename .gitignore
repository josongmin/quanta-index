# =============================================================================
# quanta-index — repository .gitignore
# =============================================================================

# Rust / Cargo
/target
target/
**/target/
*.rlib

# cargo-machete metadata for excluded grammar crates generates standalone locks.
# Workspace builds use the tracked root Cargo.lock, not these inspection outputs.
/vendor/tree-sitter-go/Cargo.lock
/vendor/tree-sitter-javascript/Cargo.lock
/vendor/tree-sitter-python/Cargo.lock
/vendor/tree-sitter-rust/Cargo.lock

# Local state / runtime artifacts
/state/
# Generated benchmark artifacts (baselines live under tools/benchmark/baselines/)
/artifacts/
*.sqlite3
*.db
*.db-*
*.sock

# Python / prompt-manager
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Agent / IDE / local tools
/.proof-pairs/
/.ken/
.DS_Store
.idea/
.vscode/
.cursor/
.claude/
.serena/
.cache/
.local/

# Generated local junk
*.log
*.tmp
*.swp

# cargo-mutants run artifacts (locally generated; not part of the build)
mutants.out/
mutants.out.old/
