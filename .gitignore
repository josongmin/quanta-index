.ruff_cache/
.mypy_cache/
.venv/
venv/
env/

# Agent / IDE / local tools
.DS_Store
.idea/
.vscode/
.cursor/
.claude/
.serena/
.cache/
.local/

# Generated local junk
*.log
*.tmp
*.swp
