+        let mut wire = valid.clone();
+        *wire.pointer_mut(pointer).expect("field") = forged;
+        assert!(ciborium::de::from_reader::<SymbolCandidate, _>(cbor(&wire).as_slice()).is_err());
+    }
+    let mut row = row;
+    row.snippet.clear();
+    assert!(ciborium::ser::into_writer(&row, Vec::new()).is_err());
+}
