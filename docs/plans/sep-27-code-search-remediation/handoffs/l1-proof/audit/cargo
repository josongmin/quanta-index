#!/Applications/Xcode.app/Contents/Developer/usr/bin/python3
import os,subprocess,sys
from pathlib import Path
BASE=Path('/tmp/quanta-l1-audit.touy8xnn')
REAL_CARGO='/Users/songmin/.cargo/bin/cargo'
args=sys.argv[1:]
# cargow acquires its unchanged canonical leaf lease before resolving cargo.
# Metadata queries from snapshot.py do not build and bypass capture recursion.
if args and args[0] in ['test','clippy']:
    prefix=os.environ['L1_AUDIT_CAPTURE_PREFIX']; rail=os.environ['L1_AUDIT_CAPTURE_RAIL']
    for suffix in ['admitted-before.json','admitted-after.json']:
        assert not (BASE/(prefix+'.'+suffix)).exists(), 'Refuse to overwrite evidence'
    subprocess.run([sys.executable,str(BASE/'snapshot.py'),rail,str(BASE/(prefix+'.admitted-before.json'))],check=True)
    result=subprocess.run([REAL_CARGO,*args])
    subprocess.run([sys.executable,str(BASE/'snapshot.py'),rail,str(BASE/(prefix+'.admitted-after.json'))],check=True)
    sys.exit(result.returncode)
os.execv(REAL_CARGO,[REAL_CARGO,*args])
