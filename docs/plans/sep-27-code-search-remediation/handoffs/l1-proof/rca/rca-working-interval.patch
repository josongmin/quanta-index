+            SearchPlaneErrorCodeV2::LexTextQueryTokenTooLong,
+        ),
+    ] {
+        let mut request = query("needle", false, false);
+        request.expr = LqExpr::Leaf(leaf);
+        let plan = LexicalPolicy::plan_query(
