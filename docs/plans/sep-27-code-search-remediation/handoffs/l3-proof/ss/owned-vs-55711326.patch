+
+impl RequestProbe {
+    fn observe(&self) -> bool {
+        if self.interrupted.load(Ordering::Relaxed) {
+            return true;
+        }
+        if self.budget.interruption().is_some() {
+            self.interrupted.store(true, Ordering::Release);
+            return true;
+        }
+        false
+    }
+
